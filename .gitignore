# Source data & build tools (not needed for the live site)
mirror_extract/
bsdata-repo/
# tools/ is ignored EXCEPT the DZC pipeline, which is core infrastructure
tools/*
!tools/dzc/
Faction Icons/
.claude/

# Source archives & reference PDFs
*.zip
# Rules PDFs are ignored except the DZC set: TTCombat publish them free and
# publicly, and tools/dzc/scan_statcards.py reads them to build the data.
*.pdf
!rules/**

# Concept art / reference images in root
robert-mallinson-*
ship_database.json

# Source logo cuts sitting in the repo ROOT, reference only. Anchored with a
# leading slash, and it has to stay anchored.
#
# This rule was written while this was still the Dropfleet repo, where "DZC
# logos" genuinely meant the wrong game. After the fork they are this app's
# brand. Unanchored, and on Windows where git defaults to core.ignorecase=true,
# DZC_Logo_* also matches assets/logos/dzc_logo_white.webp — so `git add`
# silently skipped the topbar and landing logos, and every deploy since
# 2026-07-30 has shipped an <img> pointing at a 404.
/DZC_Logo_*

# Stale / reference files
faction_data.json
fluent2-reference.html
dropfleet_commander_logo.webp
dropfleet_commander_logo_text.webp

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Editor
*.swp
*.swo
*~
.vscode/

# Temp favicon source
assets/logos/favicon_crop.png

# Lore extraction scratch — raw PDF text dumps are regenerable via pdftotext;
# the curated, verified lore-*.json files are kept. The paraphrased fetch file
# is superseded by verbatim PDF extraction (merge-verbatim-lore.js).
scripts/_pdftext/*.txt
scripts/_fetched-missing-lore.json
scripts/_missing-lore.txt

# Local art-cutout review scaffolding (originals recoverable from git history;
# delete once cutouts are curated)
assets/_art_orig/
art-review/

# Jafdy original calculator source (reference only, do not republish)
tools/dfc2-source/

# Untracked working scratch / source-art folders (not part of the live site)
DFC-Art-Assets/
partpicker/
brand-guide.html
scripts/_pdfpages/
scripts/*-ingest.json
scripts/__pycache__/
USER-PERSONAS.md


# --- DZC fork ---
# Working notes: decisions, open problems, scratch. Deliberately not public.
NOTES.md
# Reference copy of the pre-fork hand-built app; superseded by this fork.
upstream/
# Python bytecode from the DZC scanner
tools/dzc/__pycache__/

# Python: uv owns the environment. The lockfile is committed; the venv and the
# caches are not.
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
